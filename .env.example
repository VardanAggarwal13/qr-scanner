# Supabase Storage Configuration Template
# In Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_SUPABASE_BUCKET=qr-scanner

# Public URL of the deployed site; QR codes will point here (needed if you create QRs from localhost)
VITE_PUBLIC_URL=https://your-app.vercel.app
